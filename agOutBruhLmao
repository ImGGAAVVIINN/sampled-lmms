    refs = p.get('references', [])
    if not refs and isinstance(procs, list):
        # References might be in a different structure
        pass
    
    if addr not in callees_of:
        callees_of[addr] = set()
    if addr not in callers_of:
        callers_of[addr] = set()

# The JSONL doesn't seem to have embedded references. Let's use REA's get_call_graph instead
